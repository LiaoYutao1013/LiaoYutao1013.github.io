source 'https://rubygems.org'

group :jekyll_plugins do
  gem 'jekyll'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jemoji'
  gem 'webrick', '~> 1.8'
end

gem 'github-pages'
gem 'connection_pool', '2.5.0'

# Windows needs an IANA timezone database for Asia/Shanghai.
platforms :mingw, :x64_mingw, :mswin do
  gem 'tzinfo', '~> 1.2'
  gem 'tzinfo-data'
end
